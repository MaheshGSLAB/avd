# Stage 1: Base
FROM python:3.12-slim AS base
RUN pip install uv --break-system-packages && \
    uv python install 3.10 3.11 3.12 3.13

# Stage 2: Base Runtime Image (Minimal)
FROM base AS base_run
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-client git make docker.io && \
    apt-get clean && rm -rf /var/lib/apt/lists
COPY ansible_collections/arista/avd/requirements-dev.txt /requirements-dev.txt

RUN for VERSION in 3.10 3.11 3.12 3.13; do \
      uv venv --python $VERSION /UV$VERSION && \
      /UV$VERSION/bin/python -m ensurepip --upgrade && \
      /UV$VERSION/bin/python -m pip install --no-cache-dir \
      mock pytest pytest-mock pytest-xdist pyyaml "ansible-core<2.19.0" \
      -r /requirements-dev.txt --upgrade; \
    done

# Stage 3: Build (For PyAVD)
FROM base AS build
COPY --from=base_run /UV3.10 /UV3.10
COPY --from=base_run /UV3.11 /UV3.11
COPY --from=base_run /UV3.12 /UV3.12
COPY --from=base_run /UV3.13 /UV3.13
COPY . /avd
WORKDIR /avd/python-avd
RUN apt-get update && apt-get install -y --no-install-recommends make && \
    python3 -m pip install --break-system-packages build && \
    python3 -m build --wheel --outdir /tmp/wheels && \
    for VERSION in 3.10 3.11 3.12 3.13; do \
      /UV$VERSION/bin/python -m pip install --no-cache-dir /tmp/wheels/*.whl; \
    done

# Stage 4: Final Run Image (Minimal)
FROM base AS run
COPY --from=build /UV3.10 /UV3.10
COPY --from=build /UV3.11 /UV3.11
COPY --from=build /UV3.12 /UV3.12
COPY --from=build /UV3.13 /UV3.13
COPY --from=build /avd /avd
WORKDIR /avd
