# Stage 1: Base with UV installation
FROM ubuntu:latest AS base
RUN apt-get update && apt-get install -y --no-install-recommends make curl ca-certificates && \
    update-ca-certificates && \
    curl -LsSf https://astral.sh/uv/install.sh | sh

# Copy requirements early to benefit from Docker layer caching
COPY ansible_collections/arista/avd/requirements-dev.txt /requirements-dev.txt

# Stage 2: Prebuild Virtual Environments
FROM base AS venvs
RUN mkdir -p /venvs && \
    for VERSION in 3.10 3.11 3.12 3.13; do \
      UV_PYTHON_INSTALL_DIR=/venvs/python-versions uv venv --python $VERSION /venvs/UV$VERSION && \
      /venvs/UV$VERSION/bin/python -m ensurepip --upgrade && \
      /venvs/UV$VERSION/bin/python -m pip install --upgrade pip && \
      /venvs/UV$VERSION/bin/python -m pip install \
        mock pytest pytest-mock pytest-xdist pyyaml "ansible-core<2.19.0" \
        -r /requirements-dev.txt; \
    done

# Stage 3: Base Runtime
FROM ubuntu:latest AS base_run
COPY --from=venvs /venvs /venvs

# Stage 3: Build (For PyAVD)
FROM base_run AS build

# Copy the application code
COPY . /avd
WORKDIR /avd/python-avd

# Install build dependencies and build the wheel
RUN apt-get update && apt-get install -y --no-install-recommends make && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    python3 -m pip install --break-system-packages build && \
    python3 -m build --wheel --outdir /tmp/wheels && \
    for VERSION in 3.10 3.11 3.12 3.13; do \
      /venvs/UV$VERSION/bin/python -m pip install --no-cache-dir /tmp/wheels/*.whl; \
    done

# Stage 5: Final Run Image (Minimal)
FROM ubuntu:latest AS run
COPY --from=build /venvs /venvs
COPY --from=build /avd /avd